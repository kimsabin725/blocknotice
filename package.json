{
  "name": "blocknotice",
  "version": "0.1.0",
  "description": "Signed receipts for off-chain withdrawal decisions, verifiable without the institution's server. TRUST404 2026 Track 3, Grand Prize.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "issue": "tsx src/cli.ts issue",
    "verify": "tsx src/cli.ts verify",
    "build:contracts": "forge build",
    "test:contracts": "forge test",
    "test:all": "forge test && vitest run",
    "deploy": "tsx src/deploy.ts",
    "check:deployment": "tsx src/check-deployment.ts",
    "deploy:escrow": "tsx src/deploy-escrow.ts",
    "check:escrow": "tsx src/check-escrow-deployment.ts",
    "scenarios": "tsx src/scenarios.ts",
    "report": "tsx src/report.ts",
    "demo": "npm run scenarios && npm run report"
  },
  "keywords": [
    "blockchain",
    "solidity",
    "eip-712",
    "audit-trail",
    "trust404"
  ],
  "author": "kimsabin725",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
