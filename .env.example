# Ethereum Sepolia (chainId 11155111). Copy to .env and fill in. .env is gitignored.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Hoodi mirror; check current Ethereum testnet notices before public deployment.
HOODI_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com
# Public networks only; local deployments always use the Anvil development key.
DEPLOYER_KEY=0x...
# Optional: the institution signing key's address, if it differs from the deployer.
INSTITUTION_ADDRESS=
# Optional local escrow/inbox RPC (default http://127.0.0.1:8545).
LOCAL_RPC_URL=http://127.0.0.1:8545
# Optional: deploy to the local chain from your own funded account instead of the Anvil default.
# LOCAL_DEPLOYER_KEY=0x...
